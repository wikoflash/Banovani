# Banovani — Environment Variables
# Copy this file to .env.local in apps/web and fill in your values

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Social ----
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/banovaniofficial/
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/995XXXXXXXXX

# ---- Admin ----
ADMIN_EMAIL=admin@banovani.ge

